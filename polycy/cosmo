bicep// =============================================================================
// Module: privateEndpoint.bicep

// =============================================================================

@description('Private Endpoint name, e.g. pe-cosmos-.-uks-01')
param privateEndpointName string

@description('Deployment region')
param location string = 'uksouth'

@description('Resource ID of the target resource (Cosmos account / Service Bus namespace)')
param targetResourceId string

@description('Sub-resource / group ID for the private link connection, e.g. Sql or namespace')
param groupId string

@description('Full resource ID of the CG subnet the PE NIC will be placed into (in the .-vended VNet — referenced only, never written to)')
param subnetId string

@description('Resource tags')
param tags object

resource privateEndpoint 'Microsoft.Network/privateEndpoints@2023-11-01' = {
  name: privateEndpointName
  location: location
  tags: tags
  properties: {
    subnet: {
      id: subnetId 
    }
    privateLinkServiceConnections: [
      {
        name: '${privateEndpointName}-plsc'
        properties: {
          privateLinkServiceId: targetResourceId
          groupIds: [
            groupId
          ]
        }
      }
    ]
    customNetworkInterfaceName: '${privateEndpointName}-nic'
  }
}

output privateEndpointId string = privateEndpoint.id
output privateEndpointIp string = privateEndpoint.properties.customDnsConfig