bicep// =============================================================================
// Module: cosmosdb.bicep

// =============================================================================

@description('Cosmos DB account name, e.g. cosmos-.-uks-01')
param cosmosAccountName string

@description('Deployment region — policy restricted to UK South / UK West')
@allowed([
  'uksouth'
  'ukwest'
])
param location string = 'uksouth'

@description('Name of the SQL database to create')
param databaseName string

@description('Containers to create within the database')
param containers array = [
  // { name: 'container1', partitionKeyPath: '/id', throughput: 400 }
]

@description('Use serverless capacity mode (recommended for dev) instead of provisioned throughput')
param serverless bool = true

@description('Principal IDs (managed identities / users) to be granted Cosmos DB Built-in Data Contributor at account scope. Required because local auth is disabled.')
param dataContributorPrincipalIds array = []

@description('Resource tags — keys are enforced by . tagging policy (deny effect)')
param tags object

// -----------------------------------------------------------------------------
// Cosmos DB Account
// -----------------------------------------------------------------------------
resource cosmosAccount 'Microsoft.DocumentDB/databaseAccounts@2024-05-15' = {
  name: cosmosAccountName
  location: location
  tags: tags
  kind: 'GlobalDocumentDB'
  identity: {
    type: 'SystemAssigned'
  }
  properties: {
    databaseAccountOfferType: 'Standard'
    // --- ELZ guardrails ---
    publicNetworkAccess: 'Disabled'      
    disableLocalAuth: true               
    // ----------------------
    minimalTlsVersion: 'Tls12'
    locations: [
      {
        locationName: location
        failoverPriority: 0
        isZoneRedundant: false
      }
    ]
    consistencyPolicy: {
      defaultConsistencyLevel: 'Session'
    }
    capabilities: serverless
      ? [
          {
            name: 'EnableServerless'
          }
        ]
      : []
    backupPolicy: {
      type: 'Continuous'
      continuousModeProperties: {
        tier: 'Continuous7Days'
      }
    }
    networkAclBypass: 'None'
    isVirtualNetworkFilterEnabled: false 
  }
}

// -----------------------------------------------------------------------------
// SQL Database
// -----------------------------------------------------------------------------
resource sqlDatabase 'Microsoft.DocumentDB/databaseAccounts/sqlDatabases@2024-05-15' = {
  parent: cosmosAccount
  name: databaseName
  properties: {
    resource: {
      id: databaseName
    }
  }
}

// -----------------------------------------------------------------------------
// Containers
// -----------------------------------------------------------------------------
resource sqlContainers 'Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers@2024-05-15' = [
  for container in containers: {
    parent: sqlDatabase
    name: container.name
    properties: {
      resource: {
        id: container.name
        partitionKey: {
          paths: [
            container.partitionKeyPath
          ]
          kind: 'Hash'
          version: 2
        }
      }
      options: serverless
        ? {}
        : {
            throughput: container.?throughput ?? 400
          }
    }
  }
]

// -----------------------------------------------------------------------------
// SQL Role Assignments (data plane) — avoids 403s post-deployment
// Built-in role: Cosmos DB Built-in Data Contributor
// -----------------------------------------------------------------------------
var cosmosDataContributorRoleId = ''

resource sqlRoleAssignments 'Microsoft.DocumentDB/databaseAccounts/sqlRoleAssignments@2024-05-15' = [
  for principalId in dataContributorPrincipalIds: {
    parent: cosmosAccount
    name: guid(cosmosAccount.id, principalId, cosmosDataContributorRoleId)
    properties: {
      roleDefinitionId: '${cosmosAccount.id}/sqlRoleDefinitions/${cosmosDataContributorRoleId}'
      principalId: principalId
      scope: cosmosAccount.id
    }
  }
]

// -----------------------------------------------------------------------------
// Outputs — consumed by the Private Endpoint module (step 2)
// -----------------------------------------------------------------------------
output cosmosAccountId string = cosmosAccount.id
output cosmosAccountName string = cosmosAccount.name
output systemAssignedIdentityPrincipalId string = cosmosAccount.identity.principalId


modules/servicebus.bicep

bicep// =============================================================================
// Module: servicebus.bicep
// =============================================================================

@description('Service Bus namespace name, e.g. sb-.-uks-01 (must be globally unique)')
param serviceBusNamespaceName string

@description('Deployment region')
@allowed([
  'uksouth'
  'ukwest'
])
param location string = 'uksouth'

@description('Messaging units — capped at 1 per CG cost-control policy')
@allowed([
  1
])
param messagingUnits int = 1

@description('Enable customer-managed key encryption. Must be true before queues/topics are created per . pattern. May be false for throwaway POC validation only.')
param enableCmk bool = true

@description('Resource ID of the user-assigned managed identity used to access the Key Vault key (required when enableCmk = true)')
param cmkUserAssignedIdentityId string = ''

@description('Key Vault key name for CMK (Key Vault must have soft delete + purge protection enabled)')
param cmkKeyName string = ''

@description('Key Vault URI, e.g. https://kv-.-uks-01.vault.azure.net/ (required when enableCmk = true)')
param cmkKeyVaultUri string = ''

@description('Queues to create — only deployed once encryption is in place')
param queues array = []

@description('Topics to create — only deployed once encryption is in place')
param topics array = []

@description('Resource tags — keys enforced by . tagging policy (deny effect)')
param tags object

// -----------------------------------------------------------------------------
// Service Bus Namespace (Premium)
// -----------------------------------------------------------------------------
resource serviceBusNamespace 'Microsoft.ServiceBus/namespaces@2024-01-01' = {
  name: serviceBusNamespaceName
  location: location
  tags: tags
  sku: {
    name: 'Premium'     
    tier: 'Premium'
    capacity: messagingUnits
  }
  identity: enableCmk
    ? {
        type: 'SystemAssigned, UserAssigned'
        userAssignedIdentities: {
          '${cmkUserAssignedIdentityId}': {}
        }
      }
    : {
        type: 'SystemAssigned'
      }
  properties: {
    // --- ELZ guardrails ---
    minimumTlsVersion: '1.2'             
    disableLocalAuth: true               
    publicNetworkAccess: 'Disabled'      
    // ----------------------
    zoneRedundant: false
    premiumMessagingPartitions: 1
    encryption: enableCmk
      ? {
          keySource: 'Microsoft.KeyVault'
          requireInfrastructureEncryption: false
          keyVaultProperties: [
            {
              keyName: cmkKeyName
              keyVaultUri: cmkKeyVaultUri
              identity: {
                userAssignedIdentity: cmkUserAssignedIdentityId
              }
            }
          ]
        }
      : null
  }
}

// -----------------------------------------------------------------------------
// Queues — created AFTER namespace (and therefore after CMK is applied)
// -----------------------------------------------------------------------------
resource sbQueues 'Microsoft.ServiceBus/namespaces/queues@2024-01-01' = [
  for queue in queues: {
    parent: serviceBusNamespace
    name: queue.name
    properties: {
      maxDeliveryCount: queue.?maxDeliveryCount ?? 10
      lockDuration: queue.?lockDuration ?? 'PT1M'
      defaultMessageTimeToLive: queue.?ttl ?? 'P14D'
      deadLetteringOnMessageExpiration: true
      requiresDuplicateDetection: queue.?duplicateDetection ?? false
      enablePartitioning: false
    }
  }
]

// -----------------------------------------------------------------------------
// Topics
// -----------------------------------------------------------------------------
resource sbTopics 'Microsoft.ServiceBus/namespaces/topics@2024-01-01' = [
  for topic in topics: {
    parent: serviceBusNamespace
    name: topic.name
    properties: {
      defaultMessageTimeToLive: topic.?ttl ?? 'P14D'
      requiresDuplicateDetection: topic.?duplicateDetection ?? false
      enablePartitioning: false
    }
  }
]

// -----------------------------------------------------------------------------
// Outputs — consumed by the Private Endpoint module (step 2)
// -----------------------------------------------------------------------------
output serviceBusNamespaceId string = serviceBusNamespace.id
output serviceBusNamespaceName string = serviceBusNamespace.name
output serviceBusEndpoint string = serviceBusNamespace.properties.serviceBusEndpoint
output systemAssignedIdentityPrincipalId string = serviceBusNamespace.identity.principalId


