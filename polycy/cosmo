bicep// =============================================================================
// main.bicep — 
// =============================================================================

targetScope = 'resourceGroup'

// -----------------------------------------------------------------------------
// Shared parameters
// -----------------------------------------------------------------------------
@description(' . naming convention, e.g. .')
param subscriptionCode string

@description('Region short code used in resource names')
param regionShort string = 'uks'

@description('Deployment region')
@allowed([
  'uksouth'
  'ukwest'
])
param location string = 'uksouth'

@description('Environment identifier used in tags and names')
param environment string = 'dev'

@description('Tags — keys enforced by . tagging policy (deny effect). Populate all mandated keys.')
param tags object

@description('Full resource ID of the private-endpoints subnet in the .-vended VNet')
param privateEndpointSubnetId string

// -----------------------------------------------------------------------------
// Cosmos DB parameters
// -----------------------------------------------------------------------------
param cosmosInstanceId string = '01'
param cosmosDatabaseName string
param cosmosContainers array = []
param cosmosServerless bool = true
param cosmosDataContributorPrincipalIds array = []

// -----------------------------------------------------------------------------
// Service Bus parameters
// -----------------------------------------------------------------------------
param serviceBusInstanceId string = '01'
param serviceBusQueues array = []
param serviceBusTopics array = []
param enableCmk bool = true
param cmkUserAssignedIdentityId string = ''
param cmkKeyName string = ''
param cmkKeyVaultUri string = ''

// -----------------------------------------------------------------------------
// Naming (. CAF convention: [abbrev]-[subscription]-[region]-[id])
// -----------------------------------------------------------------------------
var cosmosAccountName = 'cosmos-${subscriptionCode}-${regionShort}-${cosmosInstanceId}'
var serviceBusNamespaceName = 'sb-${subscriptionCode}-${regionShort}-${serviceBusInstanceId}'

// =============================================================================
// STEP 1a — Cosmos DB account (no PE yet)
// =============================================================================
module cosmosDb 'modules/cosmosdb.bicep' = {
  name: 'deploy-cosmosdb-${environment}'
  params: {
    cosmosAccountName: cosmosAccountName
    location: location
    databaseName: cosmosDatabaseName
    containers: cosmosContainers
    serverless: cosmosServerless
    dataContributorPrincipalIds: cosmosDataContributorPrincipalIds
    tags: tags
  }
}

// =============================================================================
// STEP 1b — Service Bus namespace (Premium, MU=1, CMK before queues/topics)
// =============================================================================
module serviceBus 'modules/servicebus.bicep' = {
  name: 'deploy-servicebus-${environment}'
  params: {
    serviceBusNamespaceName: serviceBusNamespaceName
    location: location
    messagingUnits: 1
    enableCmk: enableCmk
    cmkUserAssignedIdentityId: cmkUserAssignedIdentityId
    cmkKeyName: cmkKeyName
    cmkKeyVaultUri: cmkKeyVaultUri
    queues: serviceBusQueues
    topics: serviceBusTopics
    tags: tags
  }
}

// =============================================================================
// STEP 2 — Private Endpoints (separate modules, after accounts exist)
// =============================================================================
module cosmosPrivateEndpoint 'modules/privateEndpoint.bicep' = {
  name: 'deploy-pe-cosmos-${environment}'
  params: {
    privateEndpointName: 'pe-${cosmosAccountName}'
    location: location
    targetResourceId: cosmosDb.outputs.cosmosAccountId
    groupId: 'Sql'
    subnetId: privateEndpointSubnetId
    tags: tags
  }
  // ordering enforced implicitly: targetResourceId consumes cosmosDb.outputs
}

module serviceBusPrivateEndpoint 'modules/privateEndpoint.bicep' = {
  name: 'deploy-pe-servicebus-${environment}'
  params: {
    privateEndpointName: 'pe-${serviceBusNamespaceName}'
    location: location
    targetResourceId: serviceBus.outputs.serviceBusNamespaceId
    groupId: 'namespace'
    subnetId: privateEndpointSubnetId
    tags: tags
  }
  // ordering enforced implicitly: targetResourceId consumes serviceBus.outputs
}

// -----------------------------------------------------------------------------
// Outputs
// -----------------------------------------------------------------------------
output cosmosAccountName string = cosmosDb.outputs.cosmosAccountName
output cosmosPrivateEndpointIp string = cosmosPrivateEndpoint.outputs.privateEndpointIp
output serviceBusNamespaceName string = serviceBus.outputs.serviceBusNamespaceName
output serviceBusEndpoint string = serviceBus.outputs.serviceBusEndpoint
output serviceBusPrivateEndpointIp string = serviceBusPrivateEndpoint.outputs.privateEndpointIp


