#  Scheduled stop/start of NDR non-production environments
# Scheduled runs:  Stop at 19:00 UK time, Start at 07:00 UK time, Monday-Friday.
# Weekends are covered automatically: Friday's Stop is not undone until Monday's Start.
#
# Azure DevOps cron times are UTC. Each schedule fires at BOTH possible UTC hours
# (one for GMT, one for BST). The script checks the UK time and exits straight away
# on the "wrong" one, so you will see one short do-nothing run per schedule. That is expected.

trigger: none
pr: none

schedules:
- cron: "0 19,20 * * 1-5"      # 19:00 UK in summer (18 UTC) and winter (19 UTC)
  displayName: Stop
  branches:
    include:
    - main                     # CHANGE if your default branch is master/develop
  always: true                 # IMPORTANT: run even if no code has changed
- cron: "0 5,6 * * 1-5"        # 07:00 UK in summer (06 UTC) and winter (07 UTC)
  displayName: Start
  branches:
    include:
    - main
  always: true

# These appear when you press "Run pipeline" manually (e.g. an out-of-hours override).
# Scheduled runs always use the defaults.
parameters:
- name: action
  displayName: Action (Auto = decided by the schedule)
  type: string
  default: Auto
  values: [ Auto, Stop, Start ]
- name: environment
  displayName: Environment
  type: string
  default: All
  values: [ All, DEV, SIT, UAT, MO, Training, PPE, NFT, DR ]
- name: dryRun
  displayName: Dry run (only log what would happen, change nothing)
  type: boolean
  default: true               # CHANGE to false once testing on DEV is signed off

variables:
  serviceConnection: 'REPLACE-WITH-YOUR-EXISTING-SERVICE-CONNECTION-NAME'

pool:
  vmImage: ubuntu-latest       # If your org only allows self-hosted agents, use:  name: <your-agent-pool>

jobs:
- job: EnvScheduler
  displayName: ${{ parameters.action }} - ${{ parameters.environment }}
  timeoutInMinutes: 90
  steps:
  - checkout: self

  - task: AzureCLI@2
    displayName: Run NDR environment scheduler
    inputs:
      azureSubscription: ${{ variables.serviceConnection }}
      scriptType: pscore
      scriptLocation: scriptPath
      scriptPath: pipelines/env-scheduler/scripts/Invoke-EnvScheduler.ps1
      arguments: >-
        -Action ${{ parameters.action }}
        -Environment ${{ parameters.environment }}
        -DryRun ${{ parameters.dryRun }}
        -ReportDir $(Build.ArtifactStagingDirectory)/report

  - task: PublishPipelineArtifact@1
    displayName: Publish run report (CSV)
    condition: always()
    inputs:
      targetPath: $(Build.ArtifactStagingDirectory)/report
      artifact: env-scheduler-report-$(System.JobAttempt)


