<#
.SYNOPSIS
  BST-169496 - Stops / scales down NDR non-production resources out of hours and restores them.

.DESCRIPTION
  Stop  : Finds supported resources in each enabled environment (skipping anything tagged
          AutoShutdown=Excluded or listed in excludeResourceNames), deallocates / stops / scales
          them down, and records what it changed in <ENV>.json in blob storage.
  Start : Reads <ENV>.json and restores ONLY what the Stop run changed, to its original size.
  Auto  : Used by scheduled runs. Picks Stop/Start from the schedule name and only acts at the
          configured UK hour, so one cron pair works in both GMT and BST.

  Supported: Virtual Machines, VM Scale Sets, App Service Plans,
             Azure SQL Databases (off by default), SQL Managed Instances.
#>
[CmdletBinding()]
param(
    [ValidateSet('Auto', 'Stop', 'Start')]
    [string]$Action = 'Auto',
    [string]$Environment = 'All',
    [string]$DryRun = 'true',
    [string]$ConfigPath = (Join-Path $PSScriptRoot '../config/environments.json'),
    [string]$ReportDir = './report',
    [string]$ScheduleName = $env:BUILD_CRONSCHEDULE_DISPLAYNAME
)

$ErrorActionPreference = 'Stop'
$IsDryRun = $DryRun -eq 'true'
New-Item -ItemType Directory -Path $ReportDir -Force | Out-Null
$cfg = Get-Content -Path $ConfigPath -Raw | ConvertFrom-Json

# Front ends go down first; data tier comes back first.
$StopOrder = @(
    'microsoft.web/serverfarms',
    'microsoft.compute/virtualmachinescalesets',
    'microsoft.compute/virtualmachines',
    'microsoft.sql/servers/databases',
    'microsoft.sql/managedinstances'
)
$StartOrder = $StopOrder[($StopOrder.Count - 1)..0]

$OffHoursPerWeek = ((24 - ($cfg.stopHour - $cfg.startHour)) * 5) + 48
$Errors = [System.Collections.Generic.List[string]]::new()
$Report = [System.Collections.Generic.List[object]]::new()
$PriceCache = @{}
$StateDir = Join-Path ([IO.Path]::GetTempPath()) 'env-scheduler-state'
New-Item -ItemType Directory -Path $StateDir -Force | Out-Null

# ------------------------------------------------------------------ helpers
function Invoke-Az {
    param([Parameter(Mandatory)][string[]]$AzArgs, [switch]$Json)
    $out = & az @AzArgs --only-show-errors
    if ($LASTEXITCODE -ne 0) { throw "az $($AzArgs -join ' ') failed (exit code $LASTEXITCODE)" }
    $text = ($out -join "`n").Trim()
    if ($Json) { if ($text) { return ($text | ConvertFrom-Json) } else { return $null } }
    return $text
}

function Invoke-Change {
    param([string]$Description, [string[]]$AzArgs)
    if ($IsDryRun) { Write-Host "    [DRY-RUN] Would $Description"; return 'DryRun' }
    Write-Host "    $Description"
    Invoke-Az -AzArgs $AzArgs | Out-Null
    return 'Done'
}

function Add-Row {
    param($EnvName, $Name, $Type, $Rg, $Result, $Detail, $Saving = '')
    $Report.Add([pscustomobject]@{
        Environment = $EnvName; Action = $Action; Resource = $Name; Type = $Type
        ResourceGroup = $Rg; Result = $Result; Detail = $Detail; EstWeeklySavingGBP = $Saving
    })
    Write-Host ("  {0,-8} {1} [{2}] - {3}" -f $Result, $Name, $Type, $Detail)
}

function Get-UkNow {
    try { $tz = [TimeZoneInfo]::FindSystemTimeZoneById($cfg.timeZone) }
    catch { $tz = [TimeZoneInfo]::FindSystemTimeZoneById('GMT Standard Time') }
    return [TimeZoneInfo]::ConvertTimeFromUtc([DateTime]::UtcNow, $tz)
}

# Public Azure Retail Prices API (list price, no auth). Estimates only - excludes any discounts.
function Get-VmHourlyPrice {
    param([string]$Size, [string]$Region, [string]$Os)
    $key = "$Size|$Region|$Os"
    if ($PriceCache.ContainsKey($key)) { return $PriceCache[$key] }
    $price = $null
    try {
        $filter = "serviceName eq 'Virtual Machines' and armRegionName eq '$Region' and armSkuName eq '$Size' and priceType eq 'Consumption'"
        $uri = "https://prices.azure.com/api/retail/prices?currencyCode='GBP'&`$filter=$([uri]::EscapeDataString($filter))"
        $items = (Invoke-RestMethod -Uri $uri -TimeoutSec 30).Items | Where-Object { $_.skuName -notmatch 'Spot|Low Priority' }
        $wantWindows = $Os -eq 'Windows'
        $match = $items | Where-Object { ($_.productName -match 'Windows') -eq $wantWindows } | Select-Object -First 1
        if ($match) { $price = [double]$match.retailPrice }
    }
    catch { Write-Host "    (price lookup failed for $Size / $Region - $($_.Exception.Message))" }
    $PriceCache[$key] = $price
    return $price
}

function Get-WeeklySaving {
    param([string]$Size, [string]$Region, [string]$Os, [int]$Count = 1)
    $p = Get-VmHourlyPrice -Size $Size -Region $Region -Os $Os
    if ($null -eq $p) { return 'n/a' }
    return [math]::Round($p * $Count * $OffHoursPerWeek, 2)
}

# ------------------------------------------------------------------ state file (blob storage)
function Get-StorageArgs {
    $s = $cfg.stateStorage
    return @('--account-name', $s.accountName, '--container-name', $s.container, '--auth-mode', 'key', '--subscription', $s.subscriptionId)
}

function Initialize-StateContainer {
    $s = $cfg.stateStorage
    Invoke-Az -AzArgs @('storage', 'container', 'create', '--name', $s.container, '--account-name', $s.accountName,
        '--auth-mode', 'key', '--subscription', $s.subscriptionId) | Out-Null
}

function Read-State {
    param([string]$EnvName)
    $blob = "$EnvName.json"; $file = Join-Path $StateDir $blob
    $exists = Invoke-Az -AzArgs (@('storage', 'blob', 'exists', '--name', $blob, '--query', 'exists', '-o', 'tsv') + (Get-StorageArgs))
    if ($exists -ne 'true') { return @{} }
    Remove-Item $file -ErrorAction SilentlyContinue
    Invoke-Az -AzArgs (@('storage', 'blob', 'download', '--name', $blob, '--file', $file) + (Get-StorageArgs)) | Out-Null
    $json = Get-Content $file -Raw
    if (-not $json) { return @{} }
    return ($json | ConvertFrom-Json -AsHashtable)
}

function Write-State {
    param([string]$EnvName, [hashtable]$State)
    $blob = "$EnvName.json"; $file = Join-Path $StateDir $blob
    $State | ConvertTo-Json -Depth 5 | Set-Content -Path $file -Encoding utf8
    Invoke-Az -AzArgs (@('storage', 'blob', 'upload', '--name', $blob, '--file', $file, '--overwrite') + (Get-StorageArgs)) | Out-Null
}

# ------------------------------------------------------------------ discovery
function Get-EnvResources {
    param($E)
    $found = @()
    if ($E.resourceGroups -and @($E.resourceGroups).Count -gt 0) {
        foreach ($rg in $E.resourceGroups) { $found += @(Invoke-Az -Json -AzArgs @('resource', 'list', '-g', $rg, '-o', 'json')) }
    }
    else { $found = @(Invoke-Az -Json -AzArgs @('resource', 'list', '-o', 'json')) }

    $include = @(@($E.includeResourceNames) | Where-Object { $_ })
    $exclude = @(@($cfg.excludeResourceNames) + @($E.excludeResourceNames) | Where-Object { $_ })
    $mode = if ($cfg.selectionMode) { $cfg.selectionMode } else { 'includeList' }

    # 1. INCLUDE list
    if ($mode -eq 'includeList') {
        if ($include.Count -eq 0) {
            Write-Host "  selectionMode is 'includeList' but $($E.name) has no includeResourceNames - nothing will be touched."
            return @()
        }
        Write-Host "  Include list: $($include.Count) resource name(s)."
        $foundNames = @($found | ForEach-Object { $_.name })
        foreach ($i in $include) {
            if ($foundNames -notcontains $i) {
                Write-Host "##vso[task.logissue type=warning]$($E.name): '$i' is in includeResourceNames but was not found in the listed resource groups - check the spelling and resourceGroups."
                Add-Row -EnvName $E.name -Name $i -Type '?' -Rg '?' -Result 'NotFound' -Detail 'In include list but not found'
            }
        }
        $found = @($found | Where-Object { $include -contains $_.name })
        foreach ($r in $found | Where-Object { $StopOrder -notcontains $_.type.ToLower() }) {
            Write-Host "##vso[task.logissue type=warning]$($E.name): '$($r.name)' is type $($r.type), which the scheduler cannot stop or scale."
            Add-Row -EnvName $E.name -Name $r.name -Type $r.type -Rg $r.resourceGroup -Result 'Skipped' -Detail 'Resource type not supported'
        }
    }

    # 2. EXCLUDE list and AutoShutdown=Excluded tag always win over the include list
    $selected = @()
    foreach ($r in $found | Where-Object { ($StopOrder -contains $_.type.ToLower()) -and ($_.resourceGroup -notlike 'MC_*') }) {
        if ($exclude -contains $r.name) {
            Add-Row -EnvName $E.name -Name $r.name -Type $r.type -Rg $r.resourceGroup -Result 'Excluded' -Detail 'In excludeResourceNames'
        }
        elseif ($r.tags -and $r.tags.AutoShutdown -eq 'Excluded') {
            Add-Row -EnvName $E.name -Name $r.name -Type $r.type -Rg $r.resourceGroup -Result 'Excluded' -Detail 'Tag AutoShutdown=Excluded'
        }
        else { $selected += $r }
    }
    return @($selected | Sort-Object { $StopOrder.IndexOf($_.type.ToLower()) })
}

# ------------------------------------------------------------------ stop / scale down
function Stop-Resource {
    param($R, [hashtable]$State, [string]$EnvName)
    $rg = $R.resourceGroup; $n = $R.name; $type = $R.type.ToLower()
    $row = @{ EnvName = $EnvName; Name = $n; Type = $R.type; Rg = $rg }
    $record = @{ type = $type; name = $n; resourceGroup = $rg; changedAtUtc = [DateTime]::UtcNow.ToString('o') }

    switch ($type) {
        'microsoft.compute/virtualmachines' {
            $vm = Invoke-Az -Json -AzArgs @('vm', 'show', '-d', '-g', $rg, '-n', $n, '--query', '{power:powerState, size:hardwareProfile.vmSize, os:storageProfile.osDisk.osType}')
            if ($vm.power -ne 'VM running') { Add-Row @row -Result 'Skipped' -Detail "Not running ($($vm.power))"; return }
            $saving = Get-WeeklySaving -Size $vm.size -Region $R.location -Os $vm.os
            $res = Invoke-Change -Description "deallocate VM $n ($($vm.size))" -AzArgs @('vm', 'deallocate', '-g', $rg, '-n', $n, '--no-wait')
            $State[$R.id] = $record
            Add-Row @row -Result $res -Detail "Deallocated ($($vm.size))" -Saving $saving
        }
        'microsoft.compute/virtualmachinescalesets' {
            $ss = Invoke-Az -Json -AzArgs @('vmss', 'show', '-g', $rg, '-n', $n, '--query', '{size:sku.name, capacity:sku.capacity, os:virtualMachineProfile.storageProfile.osDisk.osType}')
            if (-not $ss.capacity) { Add-Row @row -Result 'Skipped' -Detail 'Capacity is 0'; return }
            $running = Invoke-Az -AzArgs @('vmss', 'list-instances', '-g', $rg, '-n', $n, '--expand', 'instanceView',
                '--query', "length([?instanceView.statuses[?code=='PowerState/running']])", '-o', 'tsv')
            if ([int]$running -eq 0) { Add-Row @row -Result 'Skipped' -Detail 'No running instances'; return }
            $saving = Get-WeeklySaving -Size $ss.size -Region $R.location -Os $ss.os -Count ([int]$running)
            $res = Invoke-Change -Description "deallocate scale set $n ($running x $($ss.size))" -AzArgs @('vmss', 'deallocate', '-g', $rg, '-n', $n, '--no-wait')
            $State[$R.id] = $record
            Add-Row @row -Result $res -Detail "Deallocated $running x $($ss.size)" -Saving $saving
        }
        'microsoft.web/serverfarms' {
            $c = $cfg.defaults.appServicePlan
            if (-not $c.enabled) { Add-Row @row -Result 'Skipped' -Detail 'App Service Plan scaling disabled in config'; return }
            $p = Invoke-Az -Json -AzArgs @('appservice', 'plan', 'show', '-g', $rg, '-n', $n, '--query', '{sku:sku.name, workers:sku.capacity}')
            if ($p.sku -match '^(Y1|EP|I|FC|WS|F1|D1)') { Add-Row @row -Result 'Skipped' -Detail "SKU $($p.sku) is not suitable for scaling down"; return }
            if ($p.sku -eq $c.downSku -and [int]$p.workers -le [int]$c.downWorkers) { Add-Row @row -Result 'Skipped' -Detail 'Already at off-hours size'; return }
            $res = Invoke-Change -Description "scale plan $n from $($p.sku) x$($p.workers) to $($c.downSku) x$($c.downWorkers)" `
                -AzArgs @('appservice', 'plan', 'update', '-g', $rg, '-n', $n, '--sku', $c.downSku, '--number-of-workers', "$($c.downWorkers)")
            if (-not $State.ContainsKey($R.id)) {
                $record.originalSku = $p.sku; $record.originalWorkers = [int]$p.workers
                $State[$R.id] = $record
            }
            Add-Row @row -Result $res -Detail "$($p.sku) x$($p.workers) -> $($c.downSku) x$($c.downWorkers)" -Saving 'See Cost Management'
        }
        'microsoft.sql/servers/databases' {
            $server, $db = $n -split '/', 2
            if ($db -eq 'master') { return }
            $c = $cfg.defaults.sqlDatabase
            if (-not $c.enabled) { Add-Row @row -Result 'Skipped' -Detail 'SQL Database scaling disabled in config'; return }
            $d = Invoke-Az -Json -AzArgs @('sql', 'db', 'show', '-g', $rg, '-s', $server, '-n', $db, '--query', '{so:currentServiceObjectiveName, edition:edition, pool:elasticPoolId}')
            if ($d.pool) { Add-Row @row -Result 'Skipped' -Detail 'In an elastic pool'; return }
            if ($d.so -match '_S_') { Add-Row @row -Result 'Skipped' -Detail 'Serverless - pauses itself'; return }
            if ($d.edition -in @('Hyperscale', 'DataWarehouse', 'System')) { Add-Row @row -Result 'Skipped' -Detail "Edition $($d.edition) not supported"; return }
            if ($d.so -eq $c.downServiceObjective) { Add-Row @row -Result 'Skipped' -Detail 'Already at off-hours size'; return }
            $res = Invoke-Change -Description "scale database $n from $($d.so) to $($c.downServiceObjective)" `
                -AzArgs @('sql', 'db', 'update', '-g', $rg, '-s', $server, '-n', $db, '--edition', $c.downEdition, '--service-objective', $c.downServiceObjective, '--no-wait')
            if (-not $State.ContainsKey($R.id)) {
                $record.server = $server; $record.database = $db
                $record.originalEdition = $d.edition; $record.originalServiceObjective = $d.so
                $State[$R.id] = $record
            }
            Add-Row @row -Result $res -Detail "$($d.so) -> $($c.downServiceObjective)" -Saving 'See Cost Management'
        }
        'microsoft.sql/managedinstances' {
            $st = Invoke-Az -AzArgs @('sql', 'mi', 'show', '-g', $rg, '-n', $n, '--query', 'state', '-o', 'tsv')
            if ($st -ne 'Ready') { Add-Row @row -Result 'Skipped' -Detail "State $st"; return }
            $res = Invoke-Change -Description "stop SQL Managed Instance $n (takes several minutes)" -AzArgs @('sql', 'mi', 'stop', '-g', $rg, '--mi', $n)
            $State[$R.id] = $record
            Add-Row @row -Result $res -Detail 'Instance stopped' -Saving 'See Cost Management'
        }
    }
}

# ------------------------------------------------------------------ start / restore
# Returns 'Done' or 'Drop' (remove from state) or 'DryRun' (keep).
function Start-Resource {
    param([string]$Id, [hashtable]$E, [string]$EnvName)
    $rg = $E.resourceGroup; $n = $E.name
    $row = @{ EnvName = $EnvName; Name = $n; Type = $E.type; Rg = $rg }

    switch ($E.type) {
        'microsoft.compute/virtualmachines' {
            $res = Invoke-Change -Description "start VM $n" -AzArgs @('vm', 'start', '-g', $rg, '-n', $n, '--no-wait')
        }
        'microsoft.compute/virtualmachinescalesets' {
            $res = Invoke-Change -Description "start scale set $n" -AzArgs @('vmss', 'start', '-g', $rg, '-n', $n, '--no-wait')
        }
        'microsoft.sql/managedinstances' {
            $res = Invoke-Change -Description "start SQL Managed Instance $n (takes several minutes)" -AzArgs @('sql', 'mi', 'start', '-g', $rg, '--mi', $n)
        }
        'microsoft.web/serverfarms' {
            $c = $cfg.defaults.appServicePlan
            $cur = Invoke-Az -Json -AzArgs @('appservice', 'plan', 'show', '-g', $rg, '-n', $n, '--query', '{sku:sku.name, workers:sku.capacity}')
            if ($cur.sku -ne $c.downSku) {
                Add-Row @row -Result 'Skipped' -Detail "SKU is now $($cur.sku) - changed since Stop (e.g. a Bicep deploy), left as is"
                return 'Drop'
            }
            $res = Invoke-Change -Description "restore plan $n to $($E.originalSku) x$($E.originalWorkers)" `
                -AzArgs @('appservice', 'plan', 'update', '-g', $rg, '-n', $n, '--sku', $E.originalSku, '--number-of-workers', "$($E.originalWorkers)")
        }
        'microsoft.sql/servers/databases' {
            $c = $cfg.defaults.sqlDatabase
            $cur = Invoke-Az -AzArgs @('sql', 'db', 'show', '-g', $rg, '-s', $E.server, '-n', $E.database, '--query', 'currentServiceObjectiveName', '-o', 'tsv')
            if ($cur -ne $c.downServiceObjective) {
                Add-Row @row -Result 'Skipped' -Detail "Size is now $cur - changed since Stop, left as is"
                return 'Drop'
            }
            $res = Invoke-Change -Description "restore database $n to $($E.originalServiceObjective)" `
                -AzArgs @('sql', 'db', 'update', '-g', $rg, '-s', $E.server, '-n', $E.database, '--edition', $E.originalEdition, '--service-objective', $E.originalServiceObjective, '--no-wait')
        }
        default {
            Add-Row @row -Result 'Skipped' -Detail 'Unknown type in state file'
            return 'Drop'
        }
    }
    Add-Row @row -Result $res -Detail 'Restore requested'
    return $res
}

# ================================================================== main
if ($Action -eq 'Auto') {
    if ($ScheduleName -notin @('Stop', 'Start')) {
        throw "Action 'Auto' is only for scheduled runs. For a manual run choose Stop or Start."
    }
    $Action = $ScheduleName
    $ukNow = Get-UkNow
    $targetHour = if ($Action -eq 'Stop') { [int]$cfg.stopHour } else { [int]$cfg.startHour }
    if ($ukNow.Hour -ne $targetHour) {
        Write-Host "UK time is $($ukNow.ToString('HH:mm')). $Action runs at $($targetHour):00 UK time, so this is the spare GMT/BST trigger - nothing to do."
        exit 0
    }
    if ($Action -eq 'Start' -and (@($cfg.bankHolidays) -contains $ukNow.ToString('yyyy-MM-dd'))) {
        Write-Host 'Today is a bank holiday - environments stay off.'
        exit 0
    }
}

Write-Host "Action: $Action | Environment: $Environment | Dry run: $IsDryRun"
$envs = @($cfg.environments | Where-Object { $_.enabled -and ($Environment -eq 'All' -or $_.name -eq $Environment) })
if ($envs.Count -eq 0) { Write-Host "No ENABLED environment matches '$Environment' - check config/environments.json."; exit 0 }
if (-not $IsDryRun) { Initialize-StateContainer }

foreach ($e in $envs) {
    Write-Host ''
    Write-Host "========== $($e.name) : $Action =========="
    try {
        try { $state = Read-State -EnvName $e.name }
        catch {
            if ($IsDryRun) { Write-Host "  (could not read state file during dry run: $($_.Exception.Message))"; $state = @{} }
            else { throw }
        }
        Invoke-Az -AzArgs @('account', 'set', '--subscription', $e.subscriptionId) | Out-Null

        if ($Action -eq 'Stop') {
            foreach ($r in @(Get-EnvResources -E $e)) {
                try { Stop-Resource -R $r -State $state -EnvName $e.name }
                catch {
                    $Errors.Add("[$($e.name)] $($r.name): $($_.Exception.Message)")
                    Add-Row -EnvName $e.name -Name $r.name -Type $r.type -Rg $r.resourceGroup -Result 'FAILED' -Detail $_.Exception.Message
                }
            }
        }
        else {
            $ids = @(@($state.Keys) | Sort-Object { $StartOrder.IndexOf($state[$_].type) })
            if ($ids.Count -eq 0) { Write-Host '  Nothing recorded by the last Stop run - nothing to start.' }
            foreach ($id in $ids) {
                try {
                    $res = Start-Resource -Id $id -E $state[$id] -EnvName $e.name
                    if ($res -in @('Done', 'Drop')) { $state.Remove($id) }
                }
                catch {
                    $Errors.Add("[$($e.name)] $($state[$id].name): $($_.Exception.Message)")
                    Add-Row -EnvName $e.name -Name $state[$id].name -Type $state[$id].type -Rg $state[$id].resourceGroup -Result 'FAILED' -Detail $_.Exception.Message
                }
            }
        }
        if (-not $IsDryRun) { Write-State -EnvName $e.name -State $state }
    }
    catch {
        $Errors.Add("[$($e.name)] $($_.Exception.Message)")
        Write-Host "  ERROR: $($_.Exception.Message)"
    }
}

# ------------------------------------------------------------------ report
$stamp = [DateTime]::UtcNow.ToString('yyyyMMdd-HHmm')
if ($Report.Count -gt 0) {
    $Report | Export-Csv -Path (Join-Path $ReportDir "env-scheduler-$Action-$stamp.csv") -NoTypeInformation
}
if ($Action -eq 'Stop') {
    $weekly = [double](($Report | Where-Object { $_.EstWeeklySavingGBP -is [double] } | Measure-Object -Property EstWeeklySavingGBP -Sum).Sum)
    $summary = Join-Path $ReportDir 'summary.md'
    @(
        "## NDR non-prod scheduler - $Action"
        "* Dry run: $IsDryRun"
        "* Resources processed: $($Report.Count) (failed: $($Errors.Count))"
        "* Off hours per week: $OffHoursPerWeek"
        "* Estimated weekly saving, VMs/VMSS at list price: GBP $([math]::Round($weekly, 2))"
        "* Estimated monthly: GBP $([math]::Round($weekly * 4.33, 2))"
        "* App Service Plans and SQL: confirm with Cost Management"
    ) | Set-Content -Path $summary -Encoding utf8
    Write-Host "##vso[task.uploadsummary]$summary"
}

if ($Errors.Count -gt 0) {
    foreach ($x in $Errors) { Write-Host "##vso[task.logissue type=error]$x" }
    exit 1
}
Write-Host 'Completed successfully.'




# - Scheduled stop/start of NDR non-production environments
# Scheduled runs:  Stop at 19:00 UK time, Start at 07:00 UK time, Monday-Friday.
# Weekends are covered automatically: Friday's Stop is not undone until Monday's Start.
#
# Azure DevOps cron times are UTC. Each schedule fires at BOTH possible UTC hours
# (one for GMT, one for BST). The script checks the UK time and exits straight away
# on the "wrong" one, so you will see one short do-nothing run per schedule. That is expected.

trigger: none
pr: none

schedules:
- cron: "0 18,19 * * 1-5"      # 19:00 UK in summer (18 UTC) and winter (19 UTC)
  displayName: Stop
  branches:
    include:
    - main                     # CHANGE if your default branch is master/develop
  always: true                 # IMPORTANT: run even if no code has changed
- cron: "0 6,7 * * 1-5"        # 07:00 UK in summer (06 UTC) and winter (07 UTC)
  displayName: Start
  branches:
    include:
    - main
  always: true

# These appear when you press "Run pipeline" manually (e.g. an out-of-hours override).
# Scheduled runs always use the defaults.
parameters:
- name: action
  displayName: Action (Auto = decided by the schedule)
  type: string
  default: Auto
  values: [ Auto, Stop, Start ]
- name: environment
  displayName: Environment
  type: string
  default: All
  values: [ All, DEV, SIT, UAT, MO, Training, PPE, NFT, DR ]
- name: dryRun
  displayName: Dry run (only log what would happen, change nothing)
  type: boolean
  default: true               # CHANGE to false once testing on DEV is signed off

variables:
  serviceConnection: 'REPLACE-WITH-YOUR-EXISTING-SERVICE-CONNECTION-NAME'

pool:
  vmImage: ubuntu-latest       # If your org only allows self-hosted agents, use:  name: <your-agent-pool>

jobs:
- job: EnvScheduler
  displayName: ${{ parameters.action }} - ${{ parameters.environment }}
  timeoutInMinutes: 90
  steps:
  - checkout: self

  - task: AzureCLI@2
    displayName: Run NDR environment scheduler
    inputs:
      azureSubscription: ${{ variables.serviceConnection }}
      scriptType: pscore
      scriptLocation: scriptPath
      scriptPath: pipelines/env-scheduler/scripts/Invoke-EnvScheduler.ps1
      arguments: >-
        -Action ${{ parameters.action }}
        -Environment ${{ parameters.environment }}
        -DryRun ${{ parameters.dryRun }}
        -ConfigPath $(Build.SourcesDirectory)/pipelines/env-scheduler/config/environments.json
        -ReportDir $(Build.ArtifactStagingDirectory)/report

  - task: PublishPipelineArtifact@1
    displayName: Publish run report (CSV)
    condition: always()
    inputs:
      targetPath: $(Build.ArtifactStagingDirectory)/report
      artifact: env-scheduler-report-$(System.JobAttempt)











Here's the pipeline one section at a time, in the order it appears in the file.

## 1. Comments at the top

```yaml
#  - Scheduled stop/start ...
```
Lines starting with `#` are notes for humans. Azure DevOps ignores them.

## 2. Turning off the automatic triggers

```yaml
trigger: none
pr: none
```
- `trigger: none` means **don't** run when someone pushes code. Your Bicep pipelines usually run on push, but this one shouldn't. Editing the config file shouldn't switch environments off.
- `pr: none` means don't run on pull requests either.

So this pipeline only runs **on its schedule** or **when you click Run**.

## 3. The schedule (the timer)

```yaml
schedules:
- cron: "0 18,19 * * 1-5"
  displayName: Stop
  branches:
    include:
    - main
  always: true
```
`cron` is a timetable written in 5 parts:

| Part | Value | Meaning |
|---|---|---|
| Minute | `0` | at minute 0 (on the hour) |
| Hour | `18,19` | at 18:00 **and** 19:00 |
| Day of month | `*` | any day |
| Month | `*` | any month |
| Day of week | `1-5` | Monday to Friday |

**Why two hours?** Azure DevOps only works in UTC, which never changes for summer time, but UK time does:
- In summer (BST), 19:00 UK = **18:00** UTC.
- In winter (GMT), 19:00 UK = **19:00** UTC.

So it fires at both. The script checks the real UK time, acts on the right one, and the other run ends in seconds with *"spare GMT/BST trigger – nothing to do"*. That means nobody has to edit the pipeline when the clocks change.

The other settings:
- `displayName: Stop` names this schedule. The script reads the name to know whether it should stop or start.
- `branches: include: main` uses the YAML and config on the **main** branch. Schedules don't fire from feature branches.
- `always: true` is **very important**. Without it, Azure DevOps only runs the schedule if code has changed since the last run, so it would silently stop running after the first night.

The second schedule (`0 6,7 * * 1-5`, named **Start**) works the same way for 07:00 UK. Neither schedule runs on Saturday or Sunday, so Friday's stop lasts until Monday morning.

## 4. Parameters (the options when you click Run)

```yaml
parameters:
- name: action
  default: Auto
  values: [ Auto, Stop, Start ]
- name: environment
  default: All
  values: [ All, DEV, SIT, UAT, MO, Training, PPE, NFT, DR ]
- name: dryRun
  type: boolean
  default: true
```
When you click **Run pipeline**, these show up as dropdowns and a tick box.

- **action**
  - `Auto` is for the schedule, which decides stop or start from its name.
  - `Stop` or `Start` are for manual runs, e.g. a developer needs DEV at 21:00.
- **environment** runs for all enabled environments or just one.
- **dryRun**: when ticked, the script only **logs** what it would do and changes nothing.

**Scheduled runs always use the defaults**: Auto, All, and dryRun **true**. So until you change `default: true` to `false`, even the scheduled runs are only practice runs. That's deliberate, for safety while testing.

## 5. Variables

```yaml
variables:
  serviceConnection: 'REPLACE-WITH-YOUR-EXISTING-SERVICE-CONNECTION-NAME'
```
This is the name of the service connection your Bicep pipelines already use. It's set once here and used further down.

## 6. Pool (which machine runs it)

```yaml
pool:
  vmImage: ubuntu-latest
```
This is a Microsoft-hosted Linux build machine. It comes with Azure CLI and PowerShell already installed. If your project uses your own agents (check what your Bicep pipelines use), replace it with:
```yaml
pool:
  name: your-agent-pool-name
```

## 7. The job

```yaml
jobs:
- job: EnvScheduler
  displayName: ${{ parameters.action }} - ${{ parameters.environment }}
  timeoutInMinutes: 90
```
- A **job** is a group of steps that run on one machine.
- `displayName` shows in the run history as e.g. "Stop - DEV", so you can tell runs apart.
- `timeoutInMinutes: 90` stops the job if it gets stuck. SQL Managed Instances can take a while to stop.

## 8. Steps (what actually happens)

**Step 1: get the code**
```yaml
  - checkout: self
```
This downloads your repo onto the build machine, so the script and `environments.json` are there to use.

**Step 2: log in to Azure and run the script**
```yaml
  - task: AzureCLI@2
    inputs:
      azureSubscription: ${{ variables.serviceConnection }}
      scriptType: pscore
      scriptLocation: scriptPath
      scriptPath: pipelines/env-scheduler/scripts/Invoke-EnvScheduler.ps1
      arguments: >-
        -Action ${{ parameters.action }}
        -Environment ${{ parameters.environment }}
        -DryRun ${{ parameters.dryRun }}
        -ConfigPath $(Build.SourcesDirectory)/pipelines/env-scheduler/config/environments.json
        -ReportDir $(Build.ArtifactStagingDirectory)/report
```
- `AzureCLI@2` is the same task type many Bicep pipelines use. It **logs in to Azure** with your service connection, then runs your script.
- `scriptType: pscore` means the script is PowerShell (version 7).
- `scriptPath` is where the script lives in your repo.
- `arguments` passes your choices into the script:
  - `-Action`, `-Environment` and `-DryRun` come from the parameters (section 4).
  - `-ConfigPath` tells it where `environments.json` is.
  - `-ReportDir` is the folder where it saves the CSV report.

`${{ ... }}` means "fill in a parameter value". `$(...)` means "fill in an Azure DevOps built-in value", such as the folder where the repo was downloaded.

**Step 3: save the report**
```yaml
  - task: PublishPipelineArtifact@1
    condition: always()
    inputs:
      targetPath: $(Build.ArtifactStagingDirectory)/report
      artifact: env-scheduler-report-$(System.JobAttempt)
```
- This uploads the CSV report so you can **download it from the run page**: Summary tab → "1 published".
- `condition: always()` means do this even if the script failed, so you can still see what happened.

## The whole flow

```
19:00 UK (Mon–Fri)
   │
   ▼
Schedule "Stop" fires
   │
   ▼
Build machine starts → downloads your repo
   │
   ▼
Logs in to Azure with your service connection
   │
   ▼
Script reads environments.json
   → checks UK time is right
   → stops/scales the resources in your include list
   → saves what it changed to blob storage
   │
   ▼
CSV report published to the run page

07:00 UK (Mon–Fri): same, but "Start", which restores everything it stopped
```